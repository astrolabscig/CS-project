generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  REP
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ResourceType {
  SLIDES
  NOTES
  PAST_QUESTION
  ASSIGNMENT
  SOLUTION
  LAB_MANUAL
  BOOK
  OUTLINE
  TIMETABLE
  LINK
  OTHER
}

enum ResourceStatus {
  ACTIVE
  REMOVED
}

enum RequestStatus {
  OPEN
  FULFILLED
  DISMISSED
}

enum VideoStatus {
  SUGGESTED
  APPROVED
  REJECTED
}

enum ClassSessionStatus {
  DRAFT
  PUBLISHED
}


model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  role          Role       @default(STUDENT)
  status        UserStatus @default(ACTIVE)
  indexNumber   String?    @unique
  level         Int?
  programme     String?
  cohortYear    Int?
  levelConfirmedAt DateTime?
  accounts      Account[]
  sessions      Session[]
  scopes        RepScope[]
  resources     Resource[]
  auditLogs     AuditLog[] @relation("AuditActor")
  suggestedVideos RecommendedVideo[] @relation("VideoSuggestedBy")
  approvedVideos  RecommendedVideo[] @relation("VideoApprovedBy")
  createdSessions ClassSession[]     @relation("ClassSessionCreatedBy")
  uploadedTimetables TimetableUpload[] @relation("TimetableUploadedBy")
  createdAt     DateTime   @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  String
  metadata  Json?
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  courses   Course[]
  createdAt DateTime @default(now())
}

model Course {
  id           Int        @id @default(autoincrement())
  code         String     @unique
  title        String
  level        Int
  semester     Int
  lecturer     String?
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  resources    Resource[]
  recommendedVideos RecommendedVideo[]
  createdAt    DateTime   @default(now())
  @@index([level, semester])
}

model Resource {
  id            Int            @id @default(autoincrement())
  title         String
  type          ResourceType
  academicYear  String
  storageKey    String?
  fileSize      Int?
  mimeType      String?
  externalUrl   String?
  status        ResourceStatus @default(ACTIVE)
  downloadCount Int            @default(0)
  courseId      Int
  course        Course         @relation(fields: [courseId], references: [id])
  uploadedById  String
  uploadedBy    User           @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime       @default(now())
  @@index([courseId, type])
  @@index([academicYear])
}

model RepScope {
  id     Int  @id @default(autoincrement())
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  level  Int
  @@unique([userId, level])
}

// AI-assisted, approval-gated video recommendations (YouTube Data API v3).
// A suggestion is never visible to students until a rep/admin approves it —
// no auto-publish under any circumstance. Rejected rows are kept (not hard
// deleted) so the same video isn't re-suggested and for audit history.
model RecommendedVideo {
  id            Int         @id @default(autoincrement())
  courseId      Int
  course        Course      @relation(fields: [courseId], references: [id])
  title         String
  youtubeUrl    String
  videoId       String
  channelName   String
  thumbnailUrl  String
  viewCount     Int         @default(0)
  likeCount     Int         @default(0)
  qualityScore  Float       @default(0)
  status        VideoStatus @default(SUGGESTED)
  suggestedAt   DateTime    @default(now())
  suggestedById String?
  suggestedBy   User?       @relation("VideoSuggestedBy", fields: [suggestedById], references: [id], onDelete: SetNull)
  approvedById  String?
  approvedBy    User?       @relation("VideoApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?

  @@unique([courseId, videoId])
  @@index([courseId, status])
}

// The uploaded timetable file (image/PDF) for one level's timetable. NOT a
// Resource: Resource.courseId is mandatory, but a level-wide timetable isn't
// tied to a single course — this is its own small model instead of forcing
// a course attachment that wouldn't mean anything.
model TimetableUpload {
  id             Int            @id @default(autoincrement())
  levelScope     Int            // 100-400 — the level this timetable covers
  academicPeriod String         // e.g. "2025/2026 Semester 2", free text
  storageKey     String         // R2 object key (same bucket as Resource files)
  fileName       String
  fileSize       Int
  mimeType       String
  uploadedById   String?
  uploadedBy     User?          @relation("TimetableUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  sessions       ClassSession[]

  @@index([levelScope, academicPeriod])
}

// AI-extracted, approval-gated timetable rows (Gemini vision on an uploaded
// level timetable image/PDF, e.g. a KNUST exam timetable: one table per
// level/semester covering every course, keyed by date). Mirrors
// RecommendedVideo's suggest -> review -> approve pattern: extraction only
// ever produces DRAFT rows, never visible to students until a rep/admin
// reviews and publishes them. courseCode/courseTitle are stored as text
// (not a Course FK) — the timetable may list a course before, or without,
// a matching Course record existing.
model ClassSession {
  id             Int                @id @default(autoincrement())
  levelScope     Int                // 100-400
  academicPeriod String             // e.g. "2025/2026 Semester 2"
  courseCode     String
  courseTitle    String
  date           DateTime           @db.Date
  startTime      String             // 24h "HH:MM"
  endTime        String             // 24h "HH:MM"
  venue          String?
  status         ClassSessionStatus @default(DRAFT)
  sourceUploadId Int?
  sourceUpload   TimetableUpload?   @relation(fields: [sourceUploadId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?              @relation("ClassSessionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())

  @@index([levelScope, status])
  @@index([levelScope, academicPeriod])
}

model MaterialRequest {
  id         Int           @id @default(autoincrement())
  courseCode String?
  note       String
  status     RequestStatus @default(OPEN)
  createdAt  DateTime      @default(now())
  @@index([status])
}
